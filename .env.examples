# API URL
API_URL=
INTERNAL_API_KEY=

# OTLP endpoint, no path and no trailing slash. The SDK appends /v1/traces, /v1/metrics, /v1/logs.
# Local stack: http://localhost:4318 (Alloy, published by compose.yaml).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=1.0
# Resource attribute deployment.environment.name (production | dev | local). Unset = production.
DEPLOYMENT_ENVIRONMENT=
OTEL_EXPORTER_OTLP_USERNAME=
OTEL_EXPORTER_OTLP_PASSWORD=

NEXT_PUBLIC_LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1

# Search engine indexing (set to 'true' to allow search engines in production)
NEXT_PUBLIC_ALLOW_SEARCH_ENGINES=false
# Google Search Console ownership token(s) for the HTML meta tag method, rendered on every
# tenant's <head>. The token belongs to the verifying Google user, so one value covers all
# tenants. Comma-separate several tokens if more than one user must verify. Leave empty to omit.
GOOGLE_SITE_VERIFICATION=

# Set custom base path for the application
NEXT_PUBLIC_CUSTOM_BASE_PATH=

# Mapbox
NEXT_PUBLIC_MAPBOX_API_KEY=
NEXT_PUBLIC_MAPBOX_STYLE_URL=

# Maplibre
NEXT_PUBLIC_MAPLIBRE_STYLE_URL=

# Keycloak
KEYCLOAK_BASE_URL=https://auth.c211.io
KEYCLOAK_CLIENT_ID=
KEYCLOAK_INTERNAL_SECRET=
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_SECRET=

# Strapi (required for migration tool)
STRAPI_URL=
STRAPI_TOKEN=

# Which half this process serves: app (public directory, no DB), cms (Payload
# admin, API, jobs, migrations) or all (both; default). See
# docs/cms-app-separation-plan.md.
NORSE_ROLE=

# Payload
# Payload CMS origin (plus any base path) the public app reads tenant data,
# app config and translation usage from (/api/internal/*). On DigitalOcean:
# ${norse-cms.PRIVATE_URL}. Required for NORSE_ROLE=app; unset with
# NORSE_ROLE=all, Payload is read in process.
PAYLOAD_CMS_URL=
# Public admin origin (plus any base path) on a separate CMS component, e.g.
# https://cms.example.org. The CMS uses it for password-reset links, the public app
# to redirect /admin. Set the same value on both.
CMS_ADMIN_URL=
# Shared secret for /api/internal/* and /api/getTenantBasicConfig
# (x-internal-api-key header), the same value on the public app and the CMS.
PAYLOAD_API_ROUTE_SECRET=
PAYLOAD_SECRET=
PAYLOAD_APP_CONFIG_API_KEY=

# Database
DATABASE_URI=
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=4
DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# Media
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_FORCE_PATH_STYLE=

# Translation script
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
AZURE_TRANSLATE_API_KEY=

# Cache service
CACHE_REDIS_URI=

# Translation service (for auto-translation feature)
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_REGION=global
AZURE_TRANSLATOR_KEY=
GOOGLE_TRANSLATE_CREDENTIALS_BASE64=

# Alerting
WEBHOOK_ALERT_URL=

# Email service
SENDGRID_API_KEY=

# MBOA
CUSTOM_AUTH_HOST=
CUSTOM_AUTH_PROTOCOL=
NEXTAUTH_URL=
NEXT_PUBLIC_WITH_TRAILING_SLASHES=

# Analytics (Umami)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
UMAMI_API_URL=
UMAMI_TEAM_ID=
UMAMI_USERNAME=
UMAMI_PASSWORD=

# EMS
EMS_SERVICE_URL=

# ARCJET
ARCJET_KEY=
ARCJET_ENV=
# Arcjet SDK log level (trace|debug|info|warn|error). `debug` is very verbose: use only for bounded diagnostics, never leave it on.
ARCJET_LOG_LEVEL=info
# Hosts where an Arcjet denial returns 403: comma list, or * for every host. Unset/empty = log-only everywhere (the kill switch).
ARCJET_ENFORCED_HOSTS=
# Hosts never enforced, even under *. Wins over ARCJET_ENFORCED_HOSTS. Keep mboa.c211.io here until ISS-1737.
ARCJET_UNENFORCED_HOSTS=
# Decide API timeout in ms (default 500). On timeout the request is served (fail open).
ARCJET_TIMEOUT_MS=
NEXT_PUBLIC_ARCJET_SCRIPT_URL=
