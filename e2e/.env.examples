# Playwright e2e test environment variables (see e2e/AGENTS.md).
# Copy to `e2e/.env` (or export these in your shell / CI) — not auto-loaded,
# these must be present in the process env when running `playwright test`.

# Base URL the tests run against. Defaults to http://localhost:3000.
E2E_BASE_URL=

# Selects per-tenant fixture data (e2e/fixtures/tenants.ts): taxonomy codes,
# broad queries, AI-search-enabled flag. One of MBOA | WA | VA | PA | AZ | SCC.
# Defaults to MBOA locally (matches the historical single-tenant behavior).
E2E_TENANT_KEY=

# Selects which environment's fixture flags apply (currently only affects
# `aiSearchEnabled`, e.g. WA dev vs WA prod). One of dev | prod. Defaults to dev.
E2E_TENANT_ENV=

# Authenticated favorites tests (favorites.spec.ts) via Keycloak
# (KEYCLOAK_BASE_URL, https://auth.c211.io by default — see root .env.examples).
# Both must be set together or the whole authenticated describe block skips
# itself (see e2e/env.ts hasTestCredentials).
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Slow down each Playwright action by this many ms, for local debugging.
PW_SLOWMO=

# --- Optional timeout overrides (e2e/timeouts.ts) ---
# All default to sane values; only set these to debug flakiness on a slow
# machine/CI runner or to shrink budgets locally for faster failure signal.
E2E_SEARCH_NAV_TIMEOUT_MS=
E2E_PAGE_LOAD_TIMEOUT_MS=
E2E_UI_SHELL_TIMEOUT_MS=
E2E_AUTOCOMPLETE_TIMEOUT_MS=
E2E_FOCUS_TIMEOUT_MS=
E2E_KEYBOARD_UI_STABILITY_MS=
E2E_ASYNC_UI_TIMEOUT_MS=
E2E_FAVORITES_PERSISTENCE_TIMEOUT_MS=
E2E_PRESENCE_PROBE_TIMEOUT_MS=
E2E_DEFAULT_ACTION_TIMEOUT_MS=
E2E_AUTH_NAV_TIMEOUT_MS=
E2E_TEST_TIMEOUT_MS=
